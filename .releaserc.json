{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun scripts/sync-version.ts ${nextRelease.version} && bunx oxfmt plugins/staging-device-check/.claude-plugin/plugin.json .claude-plugin/marketplace.json package.json"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "plugins/staging-device-check/.claude-plugin/plugin.json",
          ".claude-plugin/marketplace.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ],
  "tagFormat": "v${version}"
}
