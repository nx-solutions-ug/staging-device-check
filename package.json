{
  "name": "staging-device-check",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin: Lässt Claude ein Jira-Ticket auf echten Handys über BrowserStack gegen Staging testen.",
  "license": "MIT",
  "author": "nx-solutions-ug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nx-solutions-ug/staging-device-check.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "oxlint --import-plugin",
    "lint:fix": "oxlint --import-plugin --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "check:dist": "bun run build && git diff --exit-code -- plugins/staging-device-check/dist plugins/staging-device-check/workspace/harness/lib.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.0.0",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.82.0",
    "semantic-release": "^25.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.4"
}
