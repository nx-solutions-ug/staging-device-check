{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "out/**",
    "coverage/**",
    ".worktrees/**",
    "CHANGELOG.md",
    "bun.lock",
    "*.min.js",
    "*.bundle.js",
    "plugins/staging-device-check/dist/**",
    "docs/superpowers/**",
    "plugins/staging-device-check/workspace/harness/lib.js",
    "plugins/staging-device-check/workspace/package-lock.json",
    "test/fixtures/report/**"
  ]
}
