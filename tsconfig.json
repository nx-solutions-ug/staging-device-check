{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "types": ["node", "bun"],
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "tsup.config.ts"]
}
